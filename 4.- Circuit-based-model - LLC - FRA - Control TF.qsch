  «text (1750,3450) 1 7 1 0x1000000 -1 -1 "ï»¿.Vab voltage generator (Half bridge, D=1)"»
  «text (-950,1350) 1 7 1 0x1000000 -1 -1 "ï»¿.INPUT VARIABLES (D=1)"»
  «text (2550,3150) 1 7 0 0x1000000 -1 -1 "ï»¿.func sgn(x) tanh(1000*x) "»
  «text (5700,3450) 1 7 0 0x1000000 -1 -1 "ï»¿.param L=60Âµ C=27.3n Cf=330Âµ R=0.48"»
  «text (5700,3050) 1 7 0 0x1000000 -1 -1 "ï»¿.param rs=0.05 rc=0.01  rc1=(rc*R)/(rc+R)"»
  «text (5700,2700) 1 7 0 0x1000000 -1 -1 "ï»¿.param Lm=210Âµ n=16"»
  «text (-1500,4050) 2 7 1 0x1000000 -1 -1 "ï»¿.LCC CIRCUIT-BASED NON-LINEAR MODEL - FRA - CONTROL TRANSFER FUNCTION"»
  «text (2850,1700) 1 7 1 0x1000000 -1 -1 "ï»¿.note that v(osc) has a 1-V  dc level\nwe use the -1 to remove this level"»
  «text (1150,1300) 1 7 0 0x1000000 -1 -1 "ï»¿.param fs=110K fo=124.4K"»
  «text (7600,200) 1 7 0 0x1000000 -1 -1 "ï»¿.plot V(vo)"»
  «text (6350,950) 1 7 0 0x1000000 -1 -1 "ï»¿.tran 0 t0+8/freq 0 10n uic"»
  «text (8500,950) 1 7 0 0x1000000 -1 -1 "ï»¿.options reltol=0.1m"»
  «text (6350,1550) 1 7 0 0x1000000 -1 -1 "ï»¿.param t0=1m"»
  «text (6350,600) 1 7 0 0x1000000 -1 -1 "ï»¿.measure gain fra freq V(fsn) V(vo) from t0+6/freq"»
  «text (6350,1250) 1 7 0 0x1000000 -1 -1 "ï»¿.step dec param freq 100 100K 10"»
  «text (6350,1900) 1 7 0 0x1000000 -1 -1 "ï»¿.save V(fsn) V(vo) Freq"»
  «text (6350,200) 1 7 0 0x1000000 -1 -1 "ï»¿.plot V(fsn)"»
